# No app origin or CORS configuration is needed. The frontend always calls localhost:3210.
# Optional local Chrome/driver paths. Selenium Manager detects them otherwise.
# NZWH_CHROME_BINARY=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# NZWH_CHROMEDRIVER=/absolute/path/to/chromedriver
# Human CAPTCHA wait, 1-240 minutes; default 30.
NZWH_CAPTCHA_TIMEOUT_MINUTES=30
